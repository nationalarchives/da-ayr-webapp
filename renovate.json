{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days",
    "labels": ["security"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned Debian apt packages in Dockerfiles",
      "managerFilePatterns": [
        "(^|/)Dockerfile$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>repology) depName=(?<depName>debian_13/\\S+) versioning=(?<versioning>\\S+)\\s+ARG [A-Z0-9_]+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update pinned Amazon Linux dnf packages in Dockerfiles",
      "managerFilePatterns": [
        "(^|/)Dockerfile$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>repology) depName=(?<depName>amazon_2023/\\S+) versioning=(?<versioning>\\S+)\\s+ARG [A-Z0-9_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "automerge": true
    },
    {
      "description": "Pin Python to 3.13 in GitHub Actions workflows; project requires >=3.13,<3.14",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Keep Playwright runtime and Python deps in lockstep for e2e to avoid CI breakage on partial upgrades",
      "matchFileNames": [
        "e2e_tests/Dockerfile",
        "e2e_tests/requirements.txt"
      ],
      "matchPackageNames": [
        "playwright",
        "mcr.microsoft.com/playwright/python"
      ],
      "minimumGroupSize": 2,
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "groupName": "Playwright",
      "groupSlug": "playwright-group"
    }
  ]
}
