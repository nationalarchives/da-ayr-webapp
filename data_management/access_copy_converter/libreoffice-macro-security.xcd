<?xml version="1.0" encoding="UTF-8"?>
<!-- LibreOffice retains OpenOffice's registry namespace. -->
<oor:data xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Security">
      <node oor:name="Scripting">
        <!-- Disable document macros regardless of security level or trusted location.
             Finalizing the setting prevents user profiles from re-enabling them. -->
        <prop oor:name="DisableMacrosExecution" oor:finalized="true">
          <value>true</value>
        </prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
